load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

exports_files([
    "generated/tflm_generated_tests.cmake",
    "generated/tflm_sources.cmake",
])

_CORE_TARGETS = [
    "//tensorflow/lite/micro:hexdump",
    "//tensorflow/lite/micro:micro_framework",
    "//tensorflow/lite/micro:micro_profiler",
    "//tensorflow/lite/micro:op_resolvers",
    "//tensorflow/lite/micro:recording_allocators",
    "//tensorflow/lite/micro/memory_planner:non_persistent_buffer_planner_shim",
]

_PUBLIC_HEADER_EXTRA_TARGETS = [
    "//tensorflow/lite/micro/c:common",
    "//tensorflow/lite/micro/kernels/internal:compatibility",
]

_SYSTEM_TARGETS = [
    "//tensorflow/lite/micro:debug_log",
    "//tensorflow/lite/micro:micro_time",
    "//tensorflow/lite/micro:system_setup",
]

_KERNEL_TARGETS = [
    "//tensorflow/lite/micro/kernels:decompress",
    "//tensorflow/lite/micro/kernels:micro_ops",
]

_SIGNAL_TARGETS = [
    "//signal/micro/kernels:register_signal_ops",
]

_TEST_SUPPORT_TARGETS = [
    "//tensorflow/lite/micro/kernels:conv_test_common",
    "//tensorflow/lite/micro/kernels:kernel_runner",
    "//tensorflow/lite/micro/testing:micro_test",
]

_MICRO_HDRS_SCOPE = (
    _CORE_TARGETS + _SYSTEM_TARGETS + _KERNEL_TARGETS + _PUBLIC_HEADER_EXTRA_TARGETS
)

genquery(
    name = "query_core_srcs",
    expression = (
        'labels(srcs, filter("^//tensorflow/lite/micro[:/]", deps(' +
        " + ".join(_CORE_TARGETS) + ")) except (" +
        " + ".join(_KERNEL_TARGETS) + ") except (" +
        " + ".join(_SYSTEM_TARGETS) + "))"
    ),
    opts = ["--noimplicit_deps"],
    scope = _CORE_TARGETS + _KERNEL_TARGETS + _SYSTEM_TARGETS,
)

genquery(
    name = "query_system_srcs",
    expression = "labels(srcs, " + " + ".join(_SYSTEM_TARGETS) + ")",
    opts = ["--noimplicit_deps"],
    scope = _SYSTEM_TARGETS,
)

genquery(
    name = "query_kernel_srcs",
    expression = (
        'labels(srcs, filter("^//(tensorflow/lite/micro|third_party/hexagon)[:/]", ' +
        " + ".join(_KERNEL_TARGETS) +
        ' + filter("^//third_party/hexagon[:/]", deps(' +
        " + ".join(_KERNEL_TARGETS) + "))))"
    ),
    opts = ["--noimplicit_deps"],
    scope = _KERNEL_TARGETS,
)

genquery(
    name = "query_signal_srcs",
    expression = 'labels(srcs, filter("^//signal[:/]", deps(//signal/micro/kernels:register_signal_ops)))',
    opts = ["--noimplicit_deps"],
    scope = _SIGNAL_TARGETS,
)

genquery(
    name = "query_micro_hdrs",
    expression = (
        'labels(hdrs, filter("^(//tensorflow/lite/micro[:/]|//signal/micro/kernels:)", deps(' +
        " + ".join(_MICRO_HDRS_SCOPE) + ")))"
    ),
    opts = ["--noimplicit_deps"],
    scope = _MICRO_HDRS_SCOPE,
)

genquery(
    name = "query_signal_hdrs",
    expression = 'labels(hdrs, filter("^//signal[:/]", deps(//signal/micro/kernels:register_signal_ops)))',
    opts = ["--noimplicit_deps"],
    scope = _SIGNAL_TARGETS,
)

genquery(
    name = "query_test_support_srcs",
    expression = (
        'labels(srcs, filter("^//tensorflow/lite/micro[:/]", deps(' +
        " + ".join(_TEST_SUPPORT_TARGETS) + ")) except deps(" +
        " + ".join(_CORE_TARGETS + _SYSTEM_TARGETS) + "))"
    ),
    opts = ["--noimplicit_deps"],
    scope = _TEST_SUPPORT_TARGETS + _CORE_TARGETS + _SYSTEM_TARGETS,
)

# Root suites and standalone tests covering all TFLM unit, kernel, signal,
# example, and SeaNet integration cc_test targets. Note that
# `kernel_compression_tests` is generated by `tflm_platform_test_suite`
# (finalizer=True), which automatically collects all cc_test targets in
# `//tensorflow/lite/micro/kernels`, while `core_compression_tests` covers core,
# arena_allocator, memory_planner, testing, signal/micro/kernels, and
# hello_world_test.
_TEST_SCOPE_TARGETS = [
    "//signal/src/kiss_fft_wrappers:kiss_fft_wrappers_test",
    "//tensorflow/lite/micro:core_compression_tests",
    "//tensorflow/lite/micro/kernels:kernel_compression_tests",
    "//tensorflow/lite/micro/examples/hello_world:hello_world_test",
    "//tensorflow/lite/micro/examples/micro_speech:micro_speech_test",
    "//tensorflow/lite/micro/examples/person_detection:detection_responder_test",
    "//tensorflow/lite/micro/examples/person_detection:image_provider_test",
    "//tensorflow/lite/micro/examples/person_detection:person_detection_test",
    "//tensorflow/lite/micro/integration_tests/seanet/add:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/conv:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/leaky_relu:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/pad:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/quantize:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/strided_slice:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/sub:integration_test",
    "//tensorflow/lite/micro/integration_tests/seanet/transpose_conv:integration_test",
]

# Host-codegen tests that do not use generate_cc_arrays.py (and are absent from
# Makefile): metadata_test_cc invokes flatc --cpp, and
# gen_micro_mutable_op_resolver:micro_mutable_op_resolver_test tests a host
# Python code generator.
_EXCLUDED_TEST_TARGETS = [
    "//tensorflow/lite/micro/compression:metadata_test_cc",
    "//tensorflow/lite/micro/tools/gen_micro_mutable_op_resolver:micro_mutable_op_resolver_test",
]

_CC_TESTS_EXPR = (
    'kind("^cc_test rule$", deps(' + " + ".join(_TEST_SCOPE_TARGETS) + "))" +
    ' except filter("^//tensorflow/lite/micro/tools/toolchains[:/]", deps(' +
    " + ".join(_TEST_SCOPE_TARGETS) + ")) except (" +
    " + ".join(_EXCLUDED_TEST_TARGETS) + ")"
)

genquery(
    name = "query_test_deps",
    expression = (
        'filter("^//(tensorflow/lite/micro|signal|python/tflite_micro|third_party/hexagon)[:/]", deps(' +
        _CC_TESTS_EXPR + "))"
    ),
    opts = [
        "--noimplicit_deps",
        "--output=xml",
    ],
    scope = _TEST_SCOPE_TARGETS + _EXCLUDED_TEST_TARGETS,
)

genquery(
    name = "query_test_defs",
    expression = _CC_TESTS_EXPR,
    opts = [
        "--noimplicit_deps",
        "--output=build",
    ],
    scope = _TEST_SCOPE_TARGETS + _EXCLUDED_TEST_TARGETS,
)

_GENERATOR_DATA = [
    ":query_core_srcs",
    ":query_kernel_srcs",
    ":query_micro_hdrs",
    ":query_signal_hdrs",
    ":query_signal_srcs",
    ":query_system_srcs",
    ":query_test_defs",
    ":query_test_deps",
    ":query_test_support_srcs",
]

_GENERATOR_ARGS = [
    "--core_srcs=$(rootpath :query_core_srcs)",
    "--system_srcs=$(rootpath :query_system_srcs)",
    "--kernel_srcs=$(rootpath :query_kernel_srcs)",
    "--signal_srcs=$(rootpath :query_signal_srcs)",
    "--micro_hdrs=$(rootpath :query_micro_hdrs)",
    "--signal_hdrs=$(rootpath :query_signal_hdrs)",
    "--test_support_srcs=$(rootpath :query_test_support_srcs)",
    "--test_deps_xml=$(rootpath :query_test_deps)",
    "--test_defs_build=$(rootpath :query_test_defs)",
]

py_binary(
    name = "update_cmake_lists",
    srcs = ["generate_cmake_lists.py"],
    args = _GENERATOR_ARGS + ["--update_workspace"],
    data = _GENERATOR_DATA,
    main = "generate_cmake_lists.py",
)

py_test(
    name = "cmake_lists_staleness_test",
    size = "small",
    srcs = ["generate_cmake_lists.py"],
    args = _GENERATOR_ARGS + [
        "--check",
        "--sources_cmake=$(rootpath :generated/tflm_sources.cmake)",
        "--tests_cmake=$(rootpath :generated/tflm_generated_tests.cmake)",
    ],
    data = _GENERATOR_DATA + [
        ":generated/tflm_generated_tests.cmake",
        ":generated/tflm_sources.cmake",
    ],
    main = "generate_cmake_lists.py",
)
