@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT @_TFLM_BUNDLED_FLATBUFFERS@)
  find_dependency(flatbuffers CONFIG NAMES flatbuffers FlatBuffers Flatbuffers)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tflm-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tflm_codegen.cmake")

foreach(_tflm_comp IN ITEMS micro signal)
  set(tflm_${_tflm_comp}_FOUND FALSE)
  if(TARGET tflm::${_tflm_comp})
    set(tflm_${_tflm_comp}_FOUND TRUE)
  endif()
endforeach()
unset(_tflm_comp)

check_required_components(tflm)
