module(
    name = "tflm",
    version = "0.0.1",
    repo_name = "tflite_micro",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

# TFLM Dependencies

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Use http_archive instead of BCR bazel_dep because the BCR flatbuffers module
# pulls in heavy, unused transitive dependencies (grpc, rules_go, rules_nodejs,
# rules_swift, aspect_rules_js, etc.).
http_archive(
    name = "flatbuffers",
    sha256 = "9102253214dea6ae10c2ac966ea1ed2155d22202390b532d1dea64935c518ada",
    strip_prefix = "flatbuffers-25.9.23",
    urls = ["https://github.com/google/flatbuffers/archive/refs/tags/v25.9.23.tar.gz"],
)

http_archive(
    name = "kissfft",
    build_file = "//third_party/kissfft:BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//third_party/kissfft:kissfft.patch"],
    sha256 = "ac2259f84e372a582270ed7c7b709d02e6ca9c7206e40bb58de6ef77f6474872",
    strip_prefix = "kissfft-130",
    urls = ["https://github.com/mborgerding/kissfft/archive/refs/tags/v130.zip"],
)

http_archive(
    name = "cmsis_nn",
    build_file = "//tensorflow/lite/micro/tools/toolchains/arm:cmsis_nn.BUILD",
    sha256 = "c41f6d91fa118babe49f7554dd9ef3e28b7a2287e3be44e43820f63fea81e49c",
    strip_prefix = "CMSIS-NN-4ab83cc3cc98fb85ed6dafb55e8ca02f1628dcae",
    urls = ["https://github.com/ARM-software/CMSIS-NN/archive/4ab83cc3cc98fb85ed6dafb55e8ca02f1628dcae.zip"],
)

http_archive(
    name = "nnlib_hifi4",
    build_file = "//tensorflow/lite/micro/tools/toolchains/xtensa:nnlib_hifi4.BUILD",
    sha256 = "8b490e8a2f0e28e36dc5f244b4a256b5bcba393c629bf73d3e6e50817fe719af",
    strip_prefix = "xa_nnlib_hifi4",
    urls = ["https://github.com/foss-xtensa/nnlib-hifi4/raw/master/archive/xa_nnlib_hifi4_09_03_2026.zip"],
)

http_archive(
    name = "nnlib_hifi5",
    build_file = "//tensorflow/lite/micro/tools/toolchains/xtensa:nnlib_hifi5.BUILD",
    sha256 = "b96d396577813163b0271bd611aa674d5a834666986e2ace59d244d8c97544ee",
    strip_prefix = "xa_nnlib_hifi5",
    urls = ["https://github.com/foss-xtensa/nnlib-hifi5/raw/master/archive/xa_nnlib_hifi5_09_03_2026.zip"],
)

http_archive(
    name = "xi_tflmlib_vision_p6",
    build_file = "//tensorflow/lite/micro/tools/toolchains/xtensa:xi_tflmlib_vision_p6.BUILD",
    patch_args = ["-p1"],
    patches = ["//tensorflow/lite/micro/tools/toolchains/xtensa:xi_tflmlib_vision_p6.patch"],
    sha256 = "b39f6d25305afec534fff806e7531151a5b15a23f4313392801f2754a30cc461",
    strip_prefix = "xi_tflmlib_vision_p6",
    urls = ["https://github.com/foss-xtensa/tflmlib_vision/raw/main/archive/xi_tflmlib_vision_p6_22_06_29.zip"],
)

arm_toolchain = use_repo_rule("//tensorflow/lite/micro/tools/toolchains/arm:repo.bzl", "arm_toolchain")

arm_toolchain(name = "arm_none_eabi")

xtensa_toolchain = use_repo_rule("//tensorflow/lite/micro/tools/toolchains/xtensa:repo.bzl", "xtensa_toolchain")

xtensa_toolchain(name = "xtensa_toolchain")

# Python

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
    "3.14",
]

pip.whl_mods(
    additive_build_content = """\
load("@@//python:numpy_cc_targets.bzl", "extra_numpy_targets")
extra_numpy_targets()
""",
    hub_name = "tflm_pip_deps_whl_mods",
    whl_name = "numpy",
)

[
    (
        python.toolchain(
            is_default = (version == "3.13"),
            python_version = version,
        ),
        pip.parse(
            extra_hub_aliases = {
                "numpy": ["cc_headers"],
            },
            hub_name = "tflm_pip_deps",
            python_version = version,
            requirements_lock = "//python:python_requirements_%s.txt" % version.replace(".", "_"),
            whl_modifications = {
                "@tflm_pip_deps_whl_mods//:numpy.json": "numpy",
            },
        ),
    )
    for version in PYTHON_VERSIONS
]

use_repo(
    python,
    python_3_10 = "python_3_10_x86_64-unknown-linux-gnu",
    python_3_11 = "python_3_11_x86_64-unknown-linux-gnu",
    python_3_12 = "python_3_12_x86_64-unknown-linux-gnu",
    python_3_13 = "python_3_13_x86_64-unknown-linux-gnu",
    python_3_14 = "python_3_14_x86_64-unknown-linux-gnu",
)

use_repo(
    pip,
    "tflm_pip_deps",
    "tflm_pip_deps_whl_mods",
)

# Embedded Toolchains
register_toolchains(
    "//tensorflow/lite/micro/tools/toolchains/arm:cortex_m0_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/arm:cortex_m4_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/arm:cortex_m55_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/xtensa:xtensa_fusion_f1_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/xtensa:xtensa_hifi3z_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/xtensa:xtensa_hifi5_toolchain",
    "//tensorflow/lite/micro/tools/toolchains/xtensa:xtensa_vision_p6_toolchain",
)
